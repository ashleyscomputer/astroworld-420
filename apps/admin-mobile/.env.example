# Use the inventory Supabase project. Apply Step 1 migrations 0001-0003 and this branch's 0005-0008.
# Migration 0004 is an optional legacy sales extension and is not required by this inventory app.
# Only the public anon/publishable key belongs in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Or use the newer publishable key variable:
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY