# Copy to the ignored .dev.vars for local preview. Use Sites runtime secrets in hosting.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-initial-password
# ERPNext is optional until a separately hosted instance exists.
ERP_URL=https://your-erp.example.com
ERP_API_KEY=replace-with-api-key
ERP_API_SECRET=replace-with-api-secret
ERP_COMPANY=Your Company
ERP_WAREHOUSE=Stores - YC
ERP_ITEM_GROUP=Products
ERP_CUSTOMER_GROUP=Individual
ERP_TERRITORY=South Africa
