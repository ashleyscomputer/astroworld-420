# Copy to the ignored .dev.vars for local preview. Use Sites runtime secrets in hosting.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-initial-password
# Optional Firebase web-app configuration for Google sign-in (public values).
FIREBASE_GOOGLE_ENABLED=false
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
